# ============================================================
# ESG+SCRM Platform Configuration
# Copy to .env and fill in your values:  cp .env.example .env
# ============================================================

# ── Authentication ──────────────────────────────────────────
JWT_SECRET=esg_scrm_dev_secret_change_in_prod

# ── Server ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Database ────────────────────────────────────────────────
DATABASE_PATH=src/db/esg_scrm.db

# ── CORS Origins (comma-separated) ─────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ── MQTT Broker (smart meter integration) ──────────────────
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_FACTORY_ID=factory_bd_001

# ── SAP Business One ───────────────────────────────────────
SAP_B1_SERVER_URL=https://localhost:50000
SAP_B1_COMPANY_DB=TEST_DB
SAP_B1_USERNAME=manager
SAP_B1_PASSWORD=

# ── WhatsApp Business API ──────────────────────────────────
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=esg_scrm_webhook_verify

# ── LLM Configuration (optional, for ML features) ─────────
# OPENAI_API_KEY=sk-your-key-here
# DEFAULT_LLM_MODEL=gpt-4o
