# ============================================================
# ESG+SCRM Platform Configuration
# Copy to .env and fill in your values:  cp .env.example .env
# ============================================================

# ── Authentication ──────────────────────────────────────────
# IMPORTANT: JWT_SECRET is validated at startup — known insecure
# placeholders are rejected. Generate a real secret:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=<your-64-char-secret-here>
JWT_EXPIRY_HOURS=24

# RSA private key for RS256 JWT signing (asymmetric).
# When set, create_token uses RS256. When absent, falls back to HS256.
# Generate a key pair:
#   python -c "from cryptography.hazmat.primitives.asymmetric import rsa; \\
#     from cryptography.hazmat.primitives import serialization; \\
#     key = rsa.generate_private_key(public_exponent=65537, key_size=2048); \\
#     print(key.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption()).decode())"
# Store the private key securely (e.g., in a secrets manager).
# The corresponding public key is derived automatically.
# Alt: set JWT_RSA_PRIVATE_KEY_PATH=/path/to/private_key.pem
# JWT_RSA_PRIVATE_KEY=<paste-private-key-PEM-here>

# ── Server ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Database ────────────────────────────────────────────────
DATABASE_PATH=src/db/esg_scrm.db
# PostgreSQL (production): uncomment and set
# DATABASE_URL=postgresql://esg_scrm:esg_scrm_dev@localhost:5432/esg_scrm
POSTGRES_PASSWORD=esg_scrm_dev

# ── CORS Origins (comma-separated) ─────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ── MQTT Broker (smart meter integration) ──────────────────
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_FACTORY_ID=factory_bd_001

# ── SAP Business One ───────────────────────────────────────
SAP_B1_SERVER_URL=https://localhost:50000
SAP_B1_COMPANY_DB=TEST_DB
SAP_B1_USERNAME=manager
SAP_B1_PASSWORD=

# ── WhatsApp Business API (Twilio) ──────────────────────────
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_WHATSAPP_NUMBER=+1XXXXXXXXXX
# TWILIO_WEBHOOK_URL=https://your-domain.com/api/whatsapp/webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=esg_scrm_webhook_verify

# ── SMTP (email verification, password reset) ──────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@your-domain.com

# ── LLM Configuration (optional, for ML features) ─────────
# OPENAI_API_KEY=sk-your-key-here
# DEFAULT_LLM_MODEL=gpt-4o
